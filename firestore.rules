rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /agents/{agentId} {
      allow read: if true;
      allow write: if false; // Agents are static, managed outside the app
    }

    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if request.auth != null && request.resource.id == userId;
    }

    match /users/{userId}/interactions/{interactionId} {
      allow read, write: if isOwner(userId);
    }
    
    match /users/{userId}/cachedResponses/{cachedResponseId} {
      allow read, write: if isOwner(userId);
    }

    match /agents/{agentId}/metrics/{metricId} {
      allow read, write: if false; // Managed by backend processes
    }

    match /agents/{agentId}/knowledgeGraph/{knowledgeGraphId} {
      allow read, write: if false; // Managed by backend processes
    }
  }
}

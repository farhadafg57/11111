{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user profile.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "name": {
          "type": "string",
          "description": "The user's display name."
        }
      },
      "required": ["id", "email", "name"]
    },
    "Agent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Agent",
      "type": "object",
      "description": "Represents an AI agent definition.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Agent entity."
        },
        "name": {
          "type": "string",
          "description": "The name of the AI agent."
        },
        "description": {
          "type": "string",
          "description": "A description of the AI agent's purpose and functionality."
        },
        "category": {
          "type": "string",
          "description": "The category that the agent belongs to."
        },
        "icon": {
          "type": "string",
          "description": "The icon associated with the AI agent."
        }
      },
      "required": ["id", "name", "description", "category", "icon"]
    },
    "Interaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Interaction",
      "type": "object",
      "description": "Represents a log of user interactions with AI agents.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Interaction entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Interaction)"
        },
        "agentId": {
          "type": "string",
          "description": "Reference to Agent. (Relationship: Agent 1:N Interaction)"
        },
        "timestamp": {
          "type": "string",
          "description": "The timestamp of the interaction.",
          "format": "date-time"
        },
        "prompt": {
          "type": "string",
          "description": "The user's prompt or input."
        }
      },
      "required": ["id", "userId", "agentId", "timestamp", "prompt"]
    },
    "Metric": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Metric",
      "type": "object",
      "description": "Represents performance metrics for AI agents.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Metric entity."
        },
        "agentId": {
          "type": "string",
          "description": "Reference to Agent. (Relationship: Agent 1:N Metric)"
        },
        "timestamp": {
          "type": "string",
          "description": "The timestamp of the metric.",
          "format": "date-time"
        },
        "responseTime": {
          "type": "number",
          "description": "The response time of the AI agent in milliseconds."
        },
        "cpuUsage": {
          "type": "number",
          "description": "The CPU usage of the AI agent."
        },
        "memoryUsage": {
          "type": "number",
          "description": "The memory usage of the AI agent."
        }
      },
      "required": [
        "id",
        "agentId",
        "timestamp",
        "responseTime",
        "cpuUsage",
        "memoryUsage"
      ]
    },
    "KnowledgeGraph": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "KnowledgeGraph",
      "type": "object",
      "description": "Represents vector embeddings for knowledge representation.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the KnowledgeGraph entity."
        },
        "agentId": {
          "type": "string",
          "description": "Reference to Agent. (Relationship: Agent 1:N KnowledgeGraph)"
        },
        "embedding": {
          "type": "array",
          "description": "The vector embedding.",
          "items": {
            "type": "number"
          }
        },
        "text": {
          "type": "string",
          "description": "The text associated with the embedding."
        }
      },
      "required": ["id", "agentId", "embedding", "text"]
    },
    "CachedResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CachedResponse",
      "type": "object",
      "description": "Represents cached responses from AI agents.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the CachedResponse entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N CachedResponse)"
        },
        "agentId": {
          "type": "string",
          "description": "Reference to Agent. (Relationship: Agent 1:N CachedResponse)"
        },
        "prompt": {
          "type": "string",
          "description": "The user's prompt or input."
        },
        "response": {
          "type": "string",
          "description": "The AI agent's cached response."
        },
        "timestamp": {
          "type": "string",
          "description": "The timestamp of the cached response.",
          "format": "date-time"
        },
        "ttl": {
          "type": "number",
          "description": "Time to live in seconds"
        }
      },
      "required": [
        "id",
        "userId",
        "agentId",
        "prompt",
        "response",
        "timestamp",
        "ttl"
      ]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/agents/{agentId}": {
      "schema": { "$ref": "#/entities/Agent" },
      "description": "Collection of AI agent definitions. Agents are globally accessible and their definitions are static."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of user profiles. Each document represents a user authenticated via Firebase Auth."
    },
    "/users/{userId}/interactions/{interactionId}": {
      "schema": { "$ref": "#/entities/Interaction" },
      "description": "Subcollection of user interactions with AI agents."
    },
    "/agents/{agentId}/metrics/{metricId}": {
      "schema": { "$ref": "#/entities/Metric" },
      "description": "Subcollection of performance metrics for AI agents."
    },
    "/agents/{agentId}/knowledgeGraph/{knowledgeGraphId}": {
      "schema": { "$ref": "#/entities/KnowledgeGraph" },
      "description": "Subcollection of vector embeddings for knowledge representation."
    },
    "/users/{userId}/cachedResponses/{cachedResponseId}": {
      "schema": { "$ref": "#/entities/CachedResponse" },
      "description": "Subcollection of cached responses from AI agents, keyed by userId."
    }
  }
}
